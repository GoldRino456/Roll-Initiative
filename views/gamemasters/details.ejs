<% layout('layouts/boilerplate') %>

  <div class="row">
    <div class="col-6">
      <div class="card">
        <img src="<%= gm.image %>" class="card-img-top" alt="...">
        <div class="card-body">
          <h5 class="card-title">
            <%= gm.name %>
          </h5>
          <p class="card-text">
            <%= gm.bio %>
          </p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item">Contact: <%= gm.email %>
          </li>
          <li class="list-group-item">$<%= gm.price %> per Session</li>
          <li class="list-group-item">Game: <%= gm.game %>
          </li>
          <li class="list-group-item text-muted">Submitted By: <%= gm.author.username %></li>
          </li>
        </ul>
        <% if(currentUser && gm.author.equals(currentUser._id)) {%> 
        <div class="card-body">
          <div class="row">
            <div class="col-6">
              <a href="/gamemasters/<%= gm._id %>/edit" class="btn btn-primary">Edit Listing</a>
            </div>
            <div class="col-6">
              <form form action="/gamemasters/<%= gm._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
        <% } %> 
      </div>
    </div>
    <div class="col-6">
      <h2>Leave a Review</h2>
      <form action="/gamemasters/<%= gm._id %>/reviews" method="POST" class="mb-3 validated-form" novalidate>
        <div class="mb-3">
          <label class="form-label" for="rating">Rating</label>
          <input class="form-range" type="range" min="1" max="10" name="review[rating]" id="rating">
        </div>
        <div class="mb-3">
          <label class="form-label" for="body">Review</label>
          <textarea class="form-control" name="review[body]" id="body" cols="30" rows="3" required></textarea>
        </div>
        <button class="btn btn-success">Submit</button>
      </form>
      <% for(let review of gm.reviews) { %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">Rating: <%= review.rating %>
            </h5>
            <p class="card-text">Review: <%= review.body %>
            </p>
            <form action="/gamemasters/<%= gm._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>
        <% } %>
    </div>
  </div>